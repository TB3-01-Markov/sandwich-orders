          SELECT "o"."Id", "o"."CreatedAtUtc", "o"."CustomerId", "o"."CustomerName", "o"."CustomerPhone", "o"."OrderDate", "o"."Status"
          FROM "Orders" AS "o"
          WHERE "o"."CustomerId" = @customerId AND "o"."OrderDate" = @date AND "o"."Status" <> 3
          LIMIT 1
      ) AS "o1"
      LEFT JOIN (
          SELECT "o0"."Id", "o0"."Bread", "o0"."OrderId", "o0"."Quantity", "o0"."SandwichId", "o0"."UnitPrice", "s"."Id" AS "Id0", "s"."DescriptionEn", "s"."DescriptionNl", "s"."ImagePath", "s"."IsActive", "s"."IsTemporarilyUnavailable", "s"."Kind", "s"."NameEn", "s"."NameNl", "s"."Number", "s"."Price", "s"."StockCount", "s"."StockVersion"
          FROM "OrderLines" AS "o0"
          INNER JOIN "Sandwiches" AS "s" ON "o0"."SandwichId" = "s"."Id"
      ) AS "s0" ON "o1"."Id" = "s0"."OrderId"
      ORDER BY "o1"."Id", "s0"."Id"
