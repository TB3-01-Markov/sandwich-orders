@model PreparationOverview
@{
    ViewData["Title"] = L["Today's orders"].Value;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">@L["Today's orders"] <small class="text-muted">@Dates.Format(Model.Date)</small></h1>
    <a asp-action="Today" class="btn btn-outline-secondary btn-sm">@L["Refresh"]</a>
</div>

@if (!Model.Orders.Any())
{
    <p class="text-muted">@L["No orders yet."]</p>
}
else
{
    <h2 class="h5">@L["What to prepare"]</h2>
    <table class="table table-sm align-middle mb-4">
        <thead>
        <tr>
            <th>#</th>
            <th>@L["Sandwich"]</th>
            <th>@L["Bread"]</th>
            <th class="text-end">@L["Quantity"]</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Rows)
        {
            <tr>
                <td>@row.Sandwich.Number</td>
                <td>@row.Sandwich.Name()</td>
                <td>@L.BreadName(row.Bread)</td>
                <td class="text-end">@row.Quantity</td>
            </tr>
        }
        </tbody>
        <tfoot>
        <tr>
            <th colspan="3">@L["Total"]</th>
            <th class="text-end">@Model.TotalSandwiches &middot; @Money.Format(Model.TotalAmount)</th>
        </tr>
        </tfoot>
    </table>

    <h2 class="h5">@L["Who ordered what"]</h2>
    <div class="table-responsive">
    <table class="table table-sm align-middle">
        <thead>
        <tr>
            <th>@L["Name"]</th>
            <th>@L["Phone"]</th>
            <th>@L["Sandwich"]</th>
            <th>@L["Bread"]</th>
            <th class="text-end">@L["Price"]</th>
            <th>@L["Status"]</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var order in Model.Orders)
        {
            var first = true;
            foreach (var line in order.Lines)
            {
                <tr class="@(order.Status == OrderStatus.Collected ? "text-body-secondary" : "")">
                    <td>@order.CustomerName</td>
                    <td class="text-nowrap">
                        @if (!string.IsNullOrWhiteSpace(order.CustomerPhone))
                        {
                            <a href="tel:@order.CustomerPhone">@order.CustomerPhone</a>
                        }
                    </td>
                    <td>#@line.Sandwich.Number @line.Sandwich.Name()</td>
                    <td>@L.BreadName(line.Bread)</td>
                    <td class="text-end">@Money.Format(line.UnitPrice * line.Quantity)</td>
                    <td>@L.StatusName(order.Status)</td>
                    <td class="text-end text-nowrap">
                        @if (first)
                        {
                            if (order.Status == OrderStatus.Placed)
                            {
                                <form asp-action="SetOrderStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <input type="hidden" name="status" value="@OrderStatus.Prepared" />
                                    <button type="submit" class="btn btn-sm btn-success">@L["Ready"]</button>
                                </form>
                            }
                            if (order.Status is OrderStatus.Placed or OrderStatus.Prepared)
                            {
                                <form asp-action="SetOrderStatus" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <input type="hidden" name="status" value="@OrderStatus.Collected" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">@L["Collected"]</button>
                                </form>
                                <form asp-action="CancelOrder" method="post" class="d-inline"
                                      onsubmit="return confirm('@L["Cancel this order and put the stock back?"]');">
                                    <input type="hidden" name="id" value="@order.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@L["Cancel"]</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
                first = false;
            }
        }
        </tbody>
    </table>
    </div>
}
