@model StaffDayViewModel
@* Today's orders (with the status buttons) and, from the history, the orders of an earlier day (read only). *@
@{
    var overview = Model.Overview;
    ViewData["Title"] = Model.IsToday ? L["Today's orders"].Value : L["Orders on {0}", Dates.Format(overview.Date)].Value;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    @if (Model.IsToday)
    {
        <h1 class="h3 mb-0">@L["Today's orders"] <small class="text-muted">@Dates.Format(overview.Date)</small></h1>
        <a asp-action="Today" class="btn btn-outline-secondary btn-sm">@L["Refresh"]</a>
    }
    else
    {
        <h1 class="h3 mb-0">@L["Orders on {0}", Dates.Format(overview.Date)]</h1>
        <a asp-action="History" asp-route-year="@overview.Date.Year" asp-route-month="@overview.Date.Month"
           class="btn btn-outline-secondary btn-sm">@L["Back to the history"]</a>
    }
</div>

@if (!overview.Orders.Any())
{
    <p class="text-muted">@(Model.IsToday ? L["No orders yet."] : L["No orders on this day."])</p>
}
else
{
    <h2 class="h5">@L["What to prepare"]</h2>
    <table class="table table-sm align-middle mb-4">
        <thead>
        <tr>
            <th>#</th>
            <th>@L["Sandwich"]</th>
            <th>@L["Bread"]</th>
            <th class="text-end">@L["Quantity"]</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in overview.Rows)
        {
            <tr>
                <td>@row.Sandwich.Number</td>
                <td>@row.Sandwich.Name()</td>
                <td>@L.BreadName(row.Bread)</td>
                <td class="text-end">@row.Quantity</td>
            </tr>
        }
        </tbody>
        <tfoot>
        <tr>
            <th colspan="3">@L["Total"]</th>
            <th class="text-end">@overview.TotalSandwiches &middot; @Money.Format(overview.TotalAmount)</th>
        </tr>
        </tfoot>
    </table>

    <h2 class="h5">@L["Who ordered what"]</h2>
    @* Tablets and computers: a table. Phones: one card per order (below), so the buttons are visible
       without scrolling sideways. *@
    <div class="table-responsive d-none d-md-block">
    <table class="table table-sm align-middle">
        <thead>
        <tr>
            <th>@L["Name"]</th>
            <th>@L["Phone"]</th>
            <th>@L["Sandwich"]</th>
            <th>@L["Bread"]</th>
            <th class="text-end">@L["Price"]</th>
            <th>@L["Status"]</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var order in overview.Orders)
        {
            var first = true;
            foreach (var line in order.Lines)
            {
                <tr class="@(order.Status == OrderStatus.Collected ? "text-body-secondary" : "")">
                    <td>@order.CustomerName</td>
                    <td class="text-nowrap">
                        @if (!string.IsNullOrWhiteSpace(order.CustomerPhone))
                        {
                            <a href="tel:@order.CustomerPhone">@order.CustomerPhone</a>
                        }
                    </td>
                    <td>#@line.Sandwich.Number @line.Sandwich.Name()</td>
                    <td>@L.BreadName(line.Bread)</td>
                    <td class="text-end">@Money.Format(line.UnitPrice * line.Quantity)</td>
                    <td>@L.StatusName(order.Status)</td>
                    <td class="text-end text-nowrap">
                        @if (first && Model.IsToday)
                        {
                            <partial name="_OrderActions" model="order" />
                        }
                    </td>
                </tr>
                first = false;
            }
        }
        </tbody>
    </table>
    </div>

    <div class="d-md-none vstack gap-2">
        @foreach (var order in overview.Orders)
        {
            var badge = order.Status switch
            {
                OrderStatus.Prepared => "text-bg-success",
                OrderStatus.Collected => "text-bg-secondary",
                _ => "text-bg-primary"
            };
            <div class="card @(order.Status == OrderStatus.Collected ? "text-body-secondary" : "")">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <strong>@order.CustomerName</strong>
                        <span class="badge @badge">@L.StatusName(order.Status)</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(order.CustomerPhone))
                    {
                        <a href="tel:@order.CustomerPhone" class="small">@order.CustomerPhone</a>
                    }
                    @foreach (var line in order.Lines)
                    {
                        <div class="mt-1">
                            #@line.Sandwich.Number @line.Sandwich.Name() · @L.BreadName(line.Bread)
                            · @Money.Format(line.UnitPrice * line.Quantity)
                        </div>
                    }
                    @if (Model.IsToday && (order.Status is OrderStatus.Placed or OrderStatus.Prepared))
                    {
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <partial name="_OrderActions" model="order" />
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
