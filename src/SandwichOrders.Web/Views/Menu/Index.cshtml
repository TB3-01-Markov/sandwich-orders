@model MenuViewModel
@{
    ViewData["Title"] = L["Menu"].Value;
    var deadlineText = Model.Window.Deadline.ToString("HH:mm");
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">@L["Today's sandwiches"]</h1>
    @if (Model.Window.ClosedToday)
    {
        <span class="badge text-bg-danger fs-6">@L["Closed today"]</span>
    }
    else if (Model.Window.IsOpen)
    {
        <span class="badge text-bg-success fs-6">@L["Order before {0}", deadlineText]</span>
    }
    else
    {
        <span class="badge text-bg-danger fs-6">@L["Ordering closed at {0}", deadlineText]</span>
    }
</div>

@if (Model.TodaysOrder is not null)
{
    <div class="alert alert-info">
        @L["You have an order for today."]
        <a asp-controller="Orders" asp-action="Today" class="alert-link">@L["View my order"]</a>
    </div>
}

@if (Model.Window.Weekend)
{
    <div class="alert alert-info">@L["The canteen is closed at the weekend. You can browse the menu; ordering opens again on Monday."]</div>
}
else if (Model.Window.ClosedToday)
{
    @* The reason (holidays, renovation...) is in the announcement shown at the top of the page. *@
}
else if (!Model.Window.IsOpen)
{
    <div class="alert alert-warning">@L["Ordering is closed. You can browse the menu, but orders are accepted again tomorrow."]</div>
}
else if (!Model.IsSignedIn && Model.TodaysOrder is null)
{
    <div class="card card-body mb-3">
        <label for="guestName" class="form-label fw-semibold">@L["Your name"]</label>
        <input id="guestName" type="text" class="form-control" maxlength="100" value="@Model.GuestName"
               placeholder="@L["First name and last name"]" autocomplete="name" />
        <div class="form-text">
            @L["No account needed: type your name and pick a sandwich."]
            <a asp-controller="Account" asp-action="Login">@L["Sign in"]</a> /
            <a asp-controller="Account" asp-action="Register">@L["Register"]</a>
        </div>
    </div>
}

<form method="get" asp-controller="Menu" asp-action="Index" class="card card-body mb-3">
    <details @(Model.IsFiltered ? "open" : null)>
        <summary class="fw-semibold">@L["Filter by ingredient"]</summary>
        <div class="row g-3 mt-1">
            <div class="col-12 col-md-6">
                <div class="form-label">@L["Must contain"]</div>
                <div class="row row-cols-2 g-1">
                    @foreach (var ingredient in Model.Ingredients)
                    {
                        <div class="col">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="include" value="@ingredient.Id"
                                       id="include-@ingredient.Id" @(Model.Include.Contains(ingredient.Id) ? "checked" : null) />
                                <label class="form-check-label" for="include-@ingredient.Id">@ingredient.Name()</label>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="form-label">@L["Must not contain"]</div>
                <div class="row row-cols-2 g-1">
                    @foreach (var ingredient in Model.Ingredients)
                    {
                        <div class="col">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="exclude" value="@ingredient.Id"
                                       id="exclude-@ingredient.Id" @(Model.Exclude.Contains(ingredient.Id) ? "checked" : null) />
                                <label class="form-check-label" for="exclude-@ingredient.Id">@ingredient.Name()</label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
            <button type="submit" class="btn btn-sm btn-primary">@L["Filter"]</button>
            @if (Model.IsFiltered)
            {
                <a asp-controller="Menu" asp-action="Index" class="btn btn-sm btn-outline-secondary">@L["Clear filter"]</a>
            }
            <span class="text-muted small">@L["The filter is not an allergen guarantee. Ask the canteen if you have an allergy."]</span>
        </div>
    </details>
</form>

@if (Model.IsFiltered)
{
    <p class="text-muted" role="status">@L["Showing {0} of {1} sandwiches", Model.Sandwiches.Count, Model.TotalCount]</p>
    @if (Model.Sandwiches.Count == 0)
    {
        <div class="alert alert-secondary">@L["No sandwich matches this filter."]</div>
    }
}

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
    @foreach (var sandwich in Model.Sandwiches)
    {
        var available = sandwich.IsAvailable;
        var left = sandwich.AvailableCount;
        var canOrder = available && Model.Window.IsOpen && Model.TodaysOrder is null;
        var description = sandwich.Description();

        <div class="col">
            <div class="card h-100 @(available ? "" : "opacity-75")">
                @if (!string.IsNullOrWhiteSpace(sandwich.ImagePath))
                {
                    <img src="@sandwich.ImagePath" class="card-img-top sandwich-image" alt="@sandwich.Name()" />
                }
                else
                {
                    <div class="sandwich-placeholder" aria-hidden="true">🥖</div>
                }
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between gap-2">
                        <h2 class="h5 card-title">#@sandwich.Number @sandwich.Name()</h2>
                        <span class="fw-semibold">@Money.Format(sandwich.Price)</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(description))
                    {
                        <p class="card-text text-muted small">@description</p>
                    }

                    <p class="mb-2">
                        @if (sandwich.Kind == SandwichKind.Supplied)
                        {
                            <span class="badge text-bg-info">@L.KindName(sandwich.Kind)</span>
                        }
                        @foreach (var link in sandwich.SandwichIngredients.OrderBy(si => si.Ingredient.Name()))
                        {
                            var ingredient = link.Ingredient;
                            var missing = sandwich.Kind == SandwichKind.Prepared && !(ingredient.IsAvailable && ingredient.HasStockFor(link.Portions));
                            <span class="badge @(missing ? "text-bg-secondary text-decoration-line-through" : "text-bg-light border")">@ingredient.Name()</span>
                        }
                    </p>

                    @if (!available)
                    {
                        <span class="badge text-bg-danger align-self-start mb-2">@(left == 0 ? L["Sold out"] : L["Unavailable"])</span>
                    }
                    else if (left is not null && left <= 5)
                    {
                        <span class="badge text-bg-warning align-self-start mb-2">@L["Only {0} left", left]</span>
                    }

                    <div class="mt-auto">
                        @if (canOrder)
                        {
                            <form asp-controller="Orders" asp-action="Create" method="post" class="d-flex gap-2 order-form">
                                <input type="hidden" name="sandwichId" value="@sandwich.Id" />
                                @if (!Model.IsSignedIn)
                                {
                                    <input type="hidden" name="customerName" value="@Model.GuestName" />
                                }
                                <select name="bread" class="form-select form-select-sm" aria-label="@L["Bread"]">
                                    <option value="@Bread.White">@L["White bread"]</option>
                                    <option value="@Bread.WholeGrain">@L["Whole-grain bread"] (+@Money.Format(OrderingRules.BrownBreadSurcharge))</option>
                                </select>
                                <button type="submit" class="btn btn-primary btn-sm">@L["Order"]</button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Guests: copies the name typed at the top into the form of the sandwich that was clicked.
        // Everyone: after the first click all order buttons are disabled, so a double click sends one order.
        // (The database also refuses a second order for the same day; this just avoids the error message.)
        (function () {
            var nameInput = document.getElementById('guestName');
            var forms = document.querySelectorAll('form.order-form');
            forms.forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (nameInput) {
                        var name = nameInput.value.trim();
                        if (!name) {
                            event.preventDefault();
                            nameInput.focus();
                            nameInput.classList.add('is-invalid');
                            return;
                        }
                        form.querySelector('input[name=customerName]').value = name;
                    }
                    forms.forEach(function (f) {
                        f.querySelectorAll('button[type=submit]').forEach(function (b) { b.disabled = true; });
                    });
                });
            });
            // Coming back with the browser's Back button shows the page from cache: switch the buttons on again.
            window.addEventListener('pageshow', function () {
                forms.forEach(function (f) {
                    f.querySelectorAll('button[type=submit]').forEach(function (b) { b.disabled = false; });
                });
            });
        })();
    </script>
}
