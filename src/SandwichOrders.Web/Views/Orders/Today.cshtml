@model TodayOrderViewModel
@{
    // "✅" in the browser tab when the sandwich is ready, visible even when another tab is open.
    ViewData["Title"] = (Model.Order?.Status == OrderStatus.Prepared ? "✅ " : "") + L["My order"].Value;
}

<h1 class="h3 mb-3">@L["My order for today"]</h1>

@if (Model.Order is null)
{
    <p>@L["You have no order for today."]</p>
    <a asp-controller="Menu" asp-action="Index" class="btn btn-primary">@L["Browse the menu"]</a>
}
else
{
    var order = Model.Order;

    @* live-order.js asks GET /api/orders/today every 15 seconds and reloads this page when the status changes
       (for example when the canteen presses Ready). Not needed any more once the sandwich is collected. *@
    if (order.Status is OrderStatus.Placed or OrderStatus.Prepared)
    {
        <div id="live-order" class="d-none" data-url="/api/orders/today" data-status="@order.Status"></div>
    }

    <div class="card">
        <div class="card-body">
            <p class="mb-2"><strong>@L["Name"]:</strong> @order.CustomerName</p>

            <table class="table align-middle">
                <thead>
                <tr>
                    <th>@L["Sandwich"]</th>
                    <th>@L["Bread"]</th>
                    <th class="text-end">@L["Price"]</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var line in order.Lines)
                {
                    <tr>
                        <td>#@line.Sandwich.Number @line.Sandwich.Name()</td>
                        <td>@L.BreadName(line.Bread)</td>
                        <td class="text-end">@Money.Format(line.UnitPrice)</td>
                    </tr>
                }
                </tbody>
                <tfoot>
                <tr>
                    <th colspan="2">@L["Total"]</th>
                    <th class="text-end">@Money.Format(order.Total)</th>
                </tr>
                </tfoot>
            </table>

            @switch (order.Status)
            {
                case OrderStatus.Prepared:
                    <div class="alert alert-success mb-2">✅ @L["Your sandwich is ready. You can collect it at the canteen."]</div>
                    break;
                case OrderStatus.Collected:
                    <p class="mb-2"><span class="badge text-bg-secondary">@L.StatusName(order.Status)</span></p>
                    break;
                default:
                    <p class="mb-2"><span class="badge text-bg-primary">@L.StatusName(order.Status)</span>
                        <span class="text-muted small ms-1">@L["We will show here when your sandwich is ready."]</span></p>
                    break;
            }
            <p class="text-muted">@L["Pay at the canteen with the QR code."]</p>
            <p class="text-muted small mb-0">@L["Want to change or cancel your order? Please ask the canteen staff."]</p>
        </div>
    </div>
}

<p class="mt-3">
    <a asp-action="History" class="btn btn-outline-secondary">@L["My previous orders"]</a>
</p>

@section Scripts {
    <script src="~/js/live-order.js" asp-append-version="true"></script>
}
