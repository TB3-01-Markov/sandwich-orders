<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>SandwichOrders.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 10.0.* = latest 10.0 patch release. Keep these in step with TargetFramework in Directory.Build.props. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.*" />
    <!-- Transitive dependency of the SQL Server provider. Versions up to 10.0.12 have known vulnerabilities
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7), so the patched version is pinned here as a minimum. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SandwichOrders.Core\SandwichOrders.Core.csproj" />
  </ItemGroup>

</Project>
